# Large auto-downloaded data cache (Census ACS via folktables, OpenML) — not committed.
# Everything here is regenerated automatically on first run.
data/**
!data/.gitkeep

# Secrets — never commit real tokens (see .env.example).
.env

# Python / Jupyter / OS cruft
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# LaTeX build intermediates (the compiled PDF is committed; these are not)
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk

# JetBrains IDE
.idea/

# Local Overleaf bundle (generated convenience copy; the canonical sources live in paper/)
submission/
overleaf-submission.zip

# v2 revision working artifacts (regenerable; not committed)
cache/
overleaf_final_staging/
overleaf-submission-final.zip
paper_final.pdf
paper_final/scripts/
paper_final/paper.pdf
paper_final/*.aux
paper_final/*.log
paper_final/*.out
paper_final/*.bbl
paper_final/*.blg
# provided revision inputs (kept locally, not committed)
paper_revised_preview.pdf
overleaf-submission-revised/
