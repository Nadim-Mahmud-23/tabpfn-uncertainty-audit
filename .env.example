# Copy this file to `.env` (which is gitignored) and fill in your own tokens.
# The notebooks load these automatically; never commit real tokens.

# Hugging Face token with access to the gated Prior-Labs/tabpfn_3 model repo.
# Create at https://huggingface.co/settings/tokens and accept the model terms.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TabPFN API key from https://ux.priorlabs.ai/account
# (log in, accept the license on the Licenses tab, then copy the key).
TABPFN_TOKEN=tabpfn_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
